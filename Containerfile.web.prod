FROM node:22-alpine AS builder

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/contracts/src ./packages/contracts/src
RUN npm ci --ignore-scripts

COPY apps/web ./apps/web
WORKDIR /workspace/apps/web

ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_API_BASE_PATH=/xingdp
ARG NEXT_PUBLIC_BASE_PATH=/xingdp
ARG NEXT_PUBLIC_PUBLIC_BASE_PATH=/xingdp
ARG NEXT_PUBLIC_ASSET_PREFIX
ARG SERVER_API_BASE_URL=http://127.0.0.1:8000
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_API_BASE_PATH=${NEXT_PUBLIC_API_BASE_PATH}
ENV NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}
ENV NEXT_PUBLIC_PUBLIC_BASE_PATH=${NEXT_PUBLIC_PUBLIC_BASE_PATH}
ENV NEXT_PUBLIC_ASSET_PREFIX=${NEXT_PUBLIC_ASSET_PREFIX}
ENV SERVER_API_BASE_URL=${SERVER_API_BASE_URL}

RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /workspace
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PORT=3001
ENV PROXY_PORT=3000
ENV HOSTNAME=127.0.0.1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /workspace/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /workspace/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /workspace/apps/web/.next/static ./apps/web/.next/static
COPY --chown=nextjs:nodejs xingdp_proxy_server.cjs ./xingdp_proxy_server.cjs

USER nextjs
EXPOSE 3000

CMD ["sh", "-c", "PORT=${NEXT_PORT:-3001} HOSTNAME=127.0.0.1 node apps/web/server.js & node /workspace/xingdp_proxy_server.cjs"]
